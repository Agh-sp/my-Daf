# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# Admin panel credentials. Password hashes use scrypt$<salt hex>$<hash hex>;
# generate a unique session secret of at least 32 characters.
ADMIN_PANEL_USERNAME=
ADMIN_PANEL_PASSWORD_HASH=
ADMIN_PANEL_SESSION_SECRET=

# Local account login tokens are signed by this self-hosted secret. Generate
# at least 32 random characters (for example: openssl rand -hex 32).
LOCAL_AUTH_SECRET=

# SMS.ir phone sign-in / signup. Create an OTP template in the SMS.ir panel
# and set its numeric template ID and template parameter name (without #).
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER=CODE
# Public phone signup is disabled unless explicitly enabled on the server.
LOCAL_PHONE_SIGNUP_ENABLED=false

# Local accounts and store products are kept under this directory; keep it
# persistent and include it in your server backup. Defaults to .admin-data.
ADMIN_DATA_DIR=.admin-data

# Optional. Exact systemd service name used to show Linux journal logs.
ADMIN_SYSTEMD_UNIT=

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# Grafana Faro collector URL for browser client telemetry (errors, web
# vitals). Leave empty to keep client telemetry off.
FARO_COLLECTOR_URL=

# Private match telemetry (disabled by default)
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32
